#include <windows.h>
#include "chihana_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CHIHANA_VER_MAJOR,CHIHANA_VER_MINOR,CHIHANA_VER_PATCH,CHIHANA_VER_BUILD
 PRODUCTVERSION CHIHANA_VER_MAJOR,CHIHANA_VER_MINOR,CHIHANA_VER_PATCH,CHIHANA_VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404B0"
        BEGIN
            VALUE "ProductName",      "ChihanaGBK"
            VALUE "FileDescription",  "Kaguya 引擎遊戲 GBK 顯示補丁（version.dll 代理）"
            VALUE "FileVersion",      CHIHANA_VER_STR
            VALUE "ProductVersion",   CHIHANA_VER_STR
            VALUE "InternalName",     "version.dll"
            VALUE "OriginalFilename", "version.dll"
            VALUE "Comments",         "版本 " CHIHANA_VER_STR "（" CHIHANA_BUILD_DATE "）。延後初始化並以執行緒區域狀態包裝 Kaguya params reader；GameTitle、DisplayTitle、Brand、DefaultFirst、DefaultSecond 五個 params 欄位自動使用 GBK(936)，一般資源字串維持 Shift-JIS(932)。保留字型、標點與全形空白修補。"
            VALUE "LegalCopyright",   "ChihanaGBK 本地化輔助工具，僅供個人學習與本地化使用"
            VALUE "PrivateBuild",     CHIHANA_BUILD_DATE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
